# --- Groq (preferred) ---
GROQ_API_KEY=gsk_...                  # https://console.groq.com/keys
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MAX_TOKENS=1500
# GROQ_TIMEOUT_MS=60000

# --- Legacy Hugging Face fallback ---
# HUGGINGFACE_API_KEY=hf_...
# HF_BASE_URL=https://router.huggingface.co/v1
# HF_MODEL=Qwen/Qwen3-8B

# --- Secrets (generate long random strings) ---
MASTER_KEY=long-random-string         # creates orgs via POST /admin/orgs
UID_SALT=another-long-random-string   # salts hashed user ids for team analytics
MESSAGE_KEY=                          # optional; if empty a random key is created in .message_key on first run

BASE_URL=http://localhost:8000
FREE_TRIES=3                          # lifetime free rewrites for individual users
# TRUST_PROXY=1                       # set when behind nginx/Cloudflare so per-network limits use the real client IP
RETENTION_DAYS=30

# --- Optional: Stripe billing ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...          # recurring price for individual Pro
# STRIPE_PRICE_TEAM=price_...         # recurring per-seat price for Team
# STRIPE_PRICE_UNMASK=price_...       # recurring price for "Unmask" viewers

# --- Dev only ---
# DEV_PRO_KEYS=my-extension-api-key
# DEV_UNMASK_KEYS=my-test-viewer-key
